<?xml version="1.0" encoding="utf-8"?>
<!--
  The Spotify row: one horizontally scrolling strip of recently-played items, shown in the hero slot
  above the dock while the Spotify tile is focused.

  A near-copy of row_continue_watching.xml rather than a shared include, because both rows live in the
  same screen and each needs its own root id to be found. An <include android:id="..."> overrides the
  included root's id, so two includes of one layout cannot both be addressed.

  Focusable as a whole so a D-pad Up from the dock can land in it; the card itself takes focus.
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spotifyRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="68dp"
    android:layout_marginEnd="68dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/spotifyRowItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />
</HorizontalScrollView>
